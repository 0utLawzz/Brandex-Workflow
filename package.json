{
  "name": "brandex-mailmerge",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build && node -e \"const fs = require('node:fs'); fs.cpSync('public', '.next/standalone/public', { recursive: true }); fs.mkdirSync('.next/standalone/.next', { recursive: true }); fs.cpSync('.next/static', '.next/standalone/.next/static', { recursive: true });\"",
    "start": "node .next/standalone/server.js",
    "lint": "eslint app lib middleware.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.0.9",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "next": "^15.2.0",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/eslint-plugin": "6.15.0",
    "@typescript-eslint/parser": "6.15.0"
  }
}
