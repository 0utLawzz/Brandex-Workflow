# Production app access is required. Use a unique username and strong password.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=

# Server-only shared secret. Set the same value as the Apps Script project
# Script Property RECORDS_ACCESS_TOKEN. Never prefix this with NEXT_PUBLIC_.
APPS_SCRIPT_RECORDS_TOKEN=

# Optional public endpoint override; otherwise the built-in Apps Script URL is used.
NEXT_PUBLIC_APPS_SCRIPT_URL=
NEXT_PUBLIC_SHEET_URL=

# Supabase variables are not currently used for app persistence. Do not add a
# service-role key here or expose database credentials as NEXT_PUBLIC values.
