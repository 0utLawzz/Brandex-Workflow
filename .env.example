# Current app data is stored in each browser's localStorage. The form also
# calls the Google Apps Script backend configured in lib/data.ts by default.
# Set these only when you intentionally override those public endpoints:
NEXT_PUBLIC_APPS_SCRIPT_URL=
NEXT_PUBLIC_SHEET_URL=

# Supabase variables are not currently used for app persistence. Do not add a
# service-role key here or expose database credentials as NEXT_PUBLIC values.
